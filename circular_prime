#include <stdio.h>

int isPrime(int n)
{
    if (n < 2)
        return 0;

    for (int i = 2; i * i <= n; i++)
    {
        if (n % i == 0)
            return 0;
    }
    return 1;
}

int main()
{
    int n, temp, rem, div = 1;

    printf("Enter a number: ");
    scanf("%d", &n);

    temp = n;

    while (temp >= 10)
    {
        div *= 10;
        temp /= 10;
    }

    temp = n;

    do
    {
        if (!isPrime(temp))
        {
            printf("Not a Circular Prime");
            return 0;
        }

        rem = temp % 10;
        temp = rem * div + temp / 10;

    } while (temp != n);

    printf("Circular Prime");
    return 0;
}
